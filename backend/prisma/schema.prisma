datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          Int      @id @default(autoincrement())
  supermarket String
  name        String
  price       Float
  isOffer     Boolean  @default(false)
  url         String?
  createdAt   DateTime @default(now())
}
